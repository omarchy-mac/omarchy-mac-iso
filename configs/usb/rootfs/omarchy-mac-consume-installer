#!/bin/bash
# First boot of an installed NVMe root: delete GPT name omarchy-install on
# this disk and grow the root into that hole. Never APFS/iBoot/Recovery.
# Safe to re-run; no-ops if the installer slice is already gone.
set -euo pipefail

fail() { printf 'omarchy-mac-consume-installer: %s\n' "$*" >&2; exit 1; }

SHARE=/usr/local/share/omarchy-mac-iso
if [[ -f $SHARE/omarchy-mac-disk.sh ]]; then
  # shellcheck source=/dev/null
  source "$SHARE/omarchy-mac-disk.sh"
elif [[ -f /usr/local/sbin/omarchy-mac-disk.sh ]]; then
  # shellcheck source=/dev/null
  source /usr/local/sbin/omarchy-mac-disk.sh
else
  fail "omarchy-mac-disk.sh not found"
fi

[[ $EUID == 0 ]] || fail "run as root"

# Initrd cryptsetup open leaves the volume key in dm-crypt. After switch_root
# the initrd keyring is gone, so `cryptsetup resize` asks for a passphrase and
# systemd stdin is empty ("Nothing to read on input"). Reload the live table
# with a longer length; suspending the mapper would deadlock /.
grow_open_luks_mapper() {
  local name=$1 table backing offset backing_sectors mapper_sectors new_sectors
  [[ -n $name && -b /dev/mapper/$name ]] || return 1
  if cryptsetup -q resize "$name" </dev/null; then
    printf '==> cryptsetup resized %s\n' "$name"
    return 0
  fi
  printf '==> growing LUKS mapper %s without a passphrase\n' "$name"
  table=$(dmsetup table --showkeys "$name") || return 1
  backing=$(cryptsetup status "$name" | awk '/^[[:space:]]*device:/{print $2; exit}')
  offset=$(cryptsetup status "$name" | awk '/^[[:space:]]*offset:/{print $2; exit}')
  [[ -n $backing && -n $offset && -b $backing ]] || return 1
  backing_sectors=$(blockdev --getsz "$backing") || return 1
  mapper_sectors=$(blockdev --getsz "/dev/mapper/$name") || return 1
  new_sectors=$((backing_sectors - offset))
  if (( new_sectors <= mapper_sectors )); then
    printf '==> %s already spans %s\n' "$name" "$backing"
    return 0
  fi
  table=$(awk -v n="$new_sectors" '{$2 = n; print}' <<<"$table")
  # Keyring refs look like :32:logon:cryptsetup:UUID — gone after switch_root.
  if awk '{ exit !($5 ~ /^:/) }' <<<"$table"; then
    printf '==> LUKS mapper %s still uses a keyring key; cannot grow unattended\n' "$name" >&2
    return 1
  fi
  printf '%s\n' "$table" | dmsetup load "$name" || return 1
  dmsetup resume "$name" || return 1
}

# Still the live overlay — deleting the lowerdir would unplug the running OS.
[[ -e /omarchy-mac-overlay-write ]] && fail "still on the live overlay; reboot into the installed root first"

root_src=$(findmnt -nro SOURCE /)
root_src=${root_src%%[[]*}
[[ -n $root_src ]] || fail "could not find the device mounted on /"
# lsblk -d PKNAME is empty for /dev/mapper/root. Walk dm slaves in sysfs.
walk=$root_src
gpt_part=""
disk=""
for _ in 1 2 3 4 5; do
  type=$(lsblk -dn -o TYPE "$walk" 2>/dev/null || true)
  kname=$(lsblk -dn -o KNAME "$walk" 2>/dev/null || true)
  name=$(lsblk -dn -o NAME "$walk" 2>/dev/null || true)
  if [[ $type == part ]]; then
    gpt_part=/dev/$name
    disk=$(lsblk -dn -o PKNAME "$walk")
    [[ -n $disk ]] || disk=$(lsblk -no PKNAME "/dev/$kname" 2>/dev/null | awk 'NF{print; exit}')
    break
  fi
  slave=""
  if [[ -n $kname && -d /sys/class/block/$kname/slaves ]]; then
    slave=$(ls /sys/class/block/"$kname"/slaves 2>/dev/null | awk 'NR==1{print}')
  fi
  [[ -n $slave ]] || break
  walk=/dev/$slave
done
[[ -n $disk && -n $gpt_part ]] || fail "could not find the GPT partition that holds /"
disk_is_nvme "$disk" || fail "refusing to consume an installer slice on non-NVMe $disk"

inst=$(installer_partition_on "$disk" || true)
if [[ -z $inst ]]; then
  inst=$(omarchy_live_payload_on "$disk" "$gpt_part" || true)
  if [[ -n $inst ]]; then
    ensure_installer_partlabel "$inst" \
      || fail "found leftover OMARCHYLIVE $inst but could not name it $INSTALLER_PARTLABEL"
    inst=$(installer_partition_on "$disk" || true)
  fi
fi
disable_self() {
  systemctl disable omarchy-mac-consume-installer.service 2>/dev/null || true
}

if [[ -z $inst ]]; then
  printf 'omarchy-mac-consume-installer: no %s on %s (already consumed)\n' \
    "$INSTALLER_PARTLABEL" "$disk"
  disable_self
  exit 0
fi

[[ $inst != "$root_src" && $inst != "$gpt_part" ]] || fail "installer partition $inst is the running root"

fstype=$(lsblk -dn -o FSTYPE "$inst" || true)
parttype=$(lsblk -dn -o PARTTYPE "$inst" || true)
parttype=${parttype,,}
[[ $parttype != "$APPLE_APFS" && $parttype != "$APPLE_IBOOT" && $parttype != "$APPLE_RECOVERY" ]] \
  || fail "refusing Apple partition type on $inst"
if [[ -n $fstype && $fstype != btrfs && $fstype != crypto_LUKS ]]; then
  fail "installer $inst has unexpected fstype $fstype"
fi

if findmnt -n "$inst" >/dev/null; then
  fail "$inst is still mounted"
fi

dev=/dev/$disk
num=$(find_part_number_by_name "$dev" "$INSTALLER_PARTLABEL") \
  || fail "no GPT name $INSTALLER_PARTLABEL on $dev"
root_num=$(find_part_number_by_name "$dev" root || true)
if [[ -z $root_num ]]; then
  # LUKS/btrfs may keep PARTLABEL empty; use the GPT partition that holds /.
  root_num=$(lsblk -no PARTN "$gpt_part" 2>/dev/null || true)
fi
[[ -n $root_num ]] || fail "could not find the GPT number for the running root"

before_apple=$(apple_partition_snapshot "$dev")
printf '==> deleting %s (%s, GPT #%s) on %s\n' "$INSTALLER_PARTLABEL" "$inst" "$num" "$dev"
delete_installer_partition "$dev" "$INSTALLER_PARTLABEL" \
  || fail "parted rm of $INSTALLER_PARTLABEL failed"
partprobe "$dev" 2>/dev/null || true
command -v udevadm >/dev/null && udevadm settle --timeout=5 || true

after_apple=$(apple_partition_snapshot "$dev")
if [[ $before_apple != "$after_apple" ]]; then
  printf 'error: Apple partition types changed after deleting the installer\n' >&2
  printf 'before:\n%s\nafter:\n%s\n' "$before_apple" "$after_apple" >&2
  exit 1
fi

printf '==> growing GPT #%s into the hole the installer left\n' "$root_num"
if ! grow_partition_into_next_hole "$dev" "$root_num"; then
  printf 'warning: no following hole to grow into (installer was not at the tail?)\n' >&2
else
  partprobe "$dev" 2>/dev/null || true
  after_grow=$(apple_partition_snapshot "$dev")
  if [[ $before_apple != "$after_grow" ]]; then
    printf 'error: Apple partition types changed after grow\n' >&2
    exit 1
  fi
  if [[ $root_src == /dev/mapper/* ]]; then
    grow_open_luks_mapper "${root_src#/dev/mapper/}" \
      || fail "could not grow LUKS mapper ${root_src#/dev/mapper/}"
  fi
  if findmnt -n -o FSTYPE / | grep -qx btrfs; then
    btrfs filesystem resize max / \
      || fail "btrfs filesystem resize max / failed"
  fi
fi

printf '==> installer slice consumed on %s\n' "$dev"
lsblk -o NAME,SIZE,FSTYPE,LABEL,PARTLABEL "$dev"
disable_self
exit 0
