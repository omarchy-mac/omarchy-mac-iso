#!/usr/bin/ash
# SPDX-License-Identifier: MIT
#
# After asahi firmware + udev: mount the btrfs payload (label OMARCHYLIVE,
# subvol=@), overlay a tmpfs, switch_root into /sbin/init on that overlay.

PAYLOAD_LABEL="OMARCHYLIVE"
LIVE_MOUNT="/run/omarchy-root"
OVL_MOUNT="/run/omarchy-ovl"
NEW_ROOT="/new_root"
MARKER="omarchy-mac-live-ok"

wait_for_payload() {
  i=0
  while [ "$i" -lt 30 ]; do
    if [ -e /dev/disk/by-label/"$PAYLOAD_LABEL" ] || [ -b /dev/sda2 ]; then
      return 0
    fi
    sleep 1
    i=$((i + 1))
  done
  return 1
}

hang() {
  echo "==> $*" >/dev/console
  echo "==> $*"
  while true; do
    sleep 3600
  done
}

run_hook() {
  if command -v udevadm >/dev/null 2>&1; then
    udevadm settle --timeout=10 2>/dev/null
    udevadm trigger --action=add 2>/dev/null
    udevadm settle --timeout=10 2>/dev/null
  fi
  sleep 2

  if ! wait_for_payload; then
    hang "omarchy-usb-live: payload $PAYLOAD_LABEL never appeared (dd the GPT image, not a FAT file copy)"
  fi

  if [ -e /dev/disk/by-label/"$PAYLOAD_LABEL" ]; then
    payload_dev=$(readlink -f /dev/disk/by-label/"$PAYLOAD_LABEL")
  else
    payload_dev=/dev/sda2
  fi

  mkdir -p "$LIVE_MOUNT"
  if ! mount -t btrfs -o ro,subvol=@ "$payload_dev" "$LIVE_MOUNT"; then
    hang "omarchy-usb-live: failed to mount $payload_dev subvol=@"
  fi

  mkdir -p "$OVL_MOUNT" "$NEW_ROOT"
  mount -t tmpfs tmpfs "$OVL_MOUNT"
  mkdir -p "$OVL_MOUNT/upper" "$OVL_MOUNT/work"
  if ! mount -t overlay overlay \
      -o "lowerdir=$LIVE_MOUNT,upperdir=$OVL_MOUNT/upper,workdir=$OVL_MOUNT/work" \
      "$NEW_ROOT"; then
    hang "omarchy-usb-live: overlay mount failed"
  fi

  echo "writable overlay" >"$NEW_ROOT/omarchy-mac-overlay-write"

  if [ ! -x "$NEW_ROOT/sbin/init" ]; then
    hang "omarchy-usb-live: /sbin/init missing"
  fi
  if [ -e "$NEW_ROOT/bin/busybox" ] && [ -L "$NEW_ROOT/bin/busybox" ]; then
    hang "omarchy-usb-live: busybox is a symlink (switch_root would ENOENT)"
  fi

  echo "==> OMARCHY_MAC_USB_READY" >/dev/console
  echo "==> OMARCHY_MAC_USB_READY payload=$payload_dev marker=$(cat "$LIVE_MOUNT/$MARKER" 2>/dev/null)"

  mkdir -p "$NEW_ROOT/proc" "$NEW_ROOT/sys" "$NEW_ROOT/dev" "$NEW_ROOT/run"
  mount --move /proc "$NEW_ROOT/proc" 2>/dev/null || mount -t proc proc "$NEW_ROOT/proc"
  mount --move /sys "$NEW_ROOT/sys" 2>/dev/null || mount -t sysfs sys "$NEW_ROOT/sys"
  mount --move /dev "$NEW_ROOT/dev" 2>/dev/null || mount --bind /dev "$NEW_ROOT/dev"
  mount --move /run "$NEW_ROOT/run" 2>/dev/null || true

  echo "==> omarchy-usb-live: switch_root $NEW_ROOT /sbin/init" >/dev/console
  exec switch_root "$NEW_ROOT" /sbin/init

  hang "omarchy-usb-live: switch_root returned"
}
