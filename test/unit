# Omarchy's passwordless keyring is two halves that must ship together:
# install/login/sddm.sh strips pam_gnome_keyring so a password login cannot
# create an encrypted login keyring, and install/user/default-keyring.sh seeds
# the unencrypted Default_keyring that replaces it. An installer that stripped
# PAM without running user provisioning left no keyring at all, so the first
# secret prompted for a password nobody had set.
check "pam_gnome_keyring strip is paired with user provisioning" \
  bash -c '! grep -q pam_gnome_keyring "$0" || grep -q omarchy-provision-user "$0"' \
  "${repo_root}/configs/usb/rootfs/omarchy-mac-install"
# Seeded into the desktop user's home, not root's: default-keyring.sh writes
# $HOME/.local/share/keyrings and is a no-op if the file already exists.
check "user provisioning runs as the desktop user in their home" \
  bash -c 'b=$(sed -n "/^provision_installed_system()/,/^}/p" "$1"); [[ -n $b ]] &&
    grep -qF "$2" <<<"$b" && grep -qF "$3" <<<"$b"' \
  bash "${repo_root}/configs/usb/rootfs/omarchy-mac-install" \
  'runuser -u "$user"' 'HOME=/home/"$user"'
# @home is mounted only for the useradd/provision window; provisioning after
# the umount would write the keyring onto @ and lose it at first boot.
check "user provisioning runs before /home is unmounted" \
  awk '/useradd --root/{u=1}
       u && /provision_installed_system "\$root_mnt" "\$user"/{p=1}
       /umount "\$root_mnt\/home"/{seen=1; if (!(u && p)) bad=1}
       END{exit (seen && !bad) ? 0 : 1}' \
  "${repo_root}/configs/usb/rootfs/omarchy-mac-install"
# install.sh ends a by-hand install with snapshot_factory_baseline, and
