failures=0

check() {
    local desc="$1"; shift
    if "$@" >/dev/null 2>&1; then
        printf 'ok   - %s\n' "${desc}"
    else
        printf 'FAIL - %s\n' "${desc}"
        failures=$(( failures + 1 ))
    fi
}

