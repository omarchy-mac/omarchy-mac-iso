#!/bin/bash
# Unprivileged GPT tests for free-space install. Uses an image file, not NVMe.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../configs/usb/rootfs/omarchy-mac-disk.sh
source "${repo_root}/configs/usb/rootfs/omarchy-mac-disk.sh"

failures=0
check() {
  local desc=$1
  shift
  if bash -c "$*"; then
    printf 'ok   - %s\n' "$desc"
  else
    printf 'FAIL - %s\n' "$desc"
    failures=$((failures + 1))
  fi
}

img=$(mktemp)
cleanup() { rm -f "$img"; }
trap cleanup EXIT

truncate -s 8G "$img"
parted -s "$img" mklabel gpt \
  mkpart iBoot 1MiB 501MiB \
  mkpart APFS 501MiB 2501MiB \
  mkpart ESP 2501MiB 3001MiB \
  mkpart Recovery 6500MiB 8191MiB
parted -s "$img" type 1 "$APPLE_IBOOT"
parted -s "$img" type 2 "$APPLE_APFS"
parted -s "$img" type 4 "$APPLE_RECOVERY"

region=$(largest_free_region "$img")
read -r hole_start hole_size <<<"$region"
check "largest_free_region finds a hole" "[[ -n '$region' ]]"
check "hole is at least 2GiB" "(( $hole_size >= 2048 ))"
check "hole starts after ESP" "(( $hole_start >= 3000 ))"
read -r inset_start inset_size <<<"$(inset_free_region "$hole_start" "$hole_size")"
check "inset steps 1MiB into the hole" "(( $inset_start == $hole_start + 1 && $inset_size == $hole_size - 2 ))"

parted -s "$img" mkpart root btrfs "${hole_start}MiB" "$((hole_start + 2000))MiB"

dump_after=$(sfdisk --dump "$img")
check "iBoot type unchanged" "grep -qi '$APPLE_IBOOT' <<<'$(printf '%s' "$dump_after")'"
check "APFS type unchanged" "grep -qi '$APPLE_APFS' <<<'$(printf '%s' "$dump_after")'"
check "Recovery type unchanged" "grep -qi '$APPLE_RECOVERY' <<<'$(printf '%s' "$dump_after")'"

parted -s "$img" rm 5
part_count=$(parted -s "$img" print | awk '/^[[:space:]]*[1-9]/ { n++ } END { print n+0 }')
check "rollback leaves 4 partitions" "(( $part_count == 4 ))"
dump_rolled=$(sfdisk --dump "$img")
check "iBoot type survives rollback" "grep -qi '$APPLE_IBOOT' <<<'$(printf '%s' "$dump_rolled")'"

img_grow=$(mktemp)
truncate -s 4G "$img_grow"
parted -s "$img_grow" mklabel gpt mkpart payload 1MiB 100%
truncate -s 8G "$img_grow"
grow_gpt_to_device "$img_grow"
region=$(largest_free_region "$img_grow")
read -r gs gsz <<<"$region"
read -r gs gsz <<<"$(inset_free_region "$gs" "$gsz")"
read -r gs gsz ge <<<"$(clamp_free_region "$gs" "$gsz" "$(device_mib "$img_grow")")"
check "grown image has a hole" "(( $gsz >= 2048 ))"
parted -s "$img_grow" mkpart root btrfs "${gs}MiB" "${ge}MiB"
check "mkpart in grown image hole succeeds" "parted -s '$img_grow' print | grep -q root"
rm -f "$img_grow"

img2=$(mktemp)
truncate -s 2G "$img2"
parted -s "$img2" mklabel gpt mkpart full 1MiB 100%
if largest_free_region "$img2" >/dev/null; then
  printf 'FAIL - no-hole disk should not report a usable region\n'
  failures=$((failures + 1))
else
  printf 'ok   - no-hole disk reports no usable region\n'
fi
rm -f "$img2"

read -r rs rsz is isz <<<"$(split_hole_for_tail_installer "$hole_start" "$hole_size" 1500)"
check "tail installer sits at the end of the hole" \
  "(( $is + $isz == $hole_start + $hole_size ))"
check "leading hole is large enough to copy into" "(( $rsz >= $MIN_FREE_MIB ))"
check "installer size is the requested tail" "(( $isz == 1500 ))"

img_nvme=$(mktemp)
truncate -s 8G "$img_nvme"
parted -s "$img_nvme" mklabel gpt \
  mkpart iBoot 1MiB 501MiB \
  mkpart APFS 501MiB 2501MiB \
  mkpart ESP 2501MiB 3001MiB \
  mkpart Recovery 6500MiB 8191MiB
parted -s "$img_nvme" type 1 "$APPLE_IBOOT"
parted -s "$img_nvme" type 2 "$APPLE_APFS"
parted -s "$img_nvme" type 4 "$APPLE_RECOVERY"
region=$(largest_free_region "$img_nvme")
read -r hole_start hole_size <<<"$region"
read -r rs rsz is isz <<<"$(split_hole_for_tail_installer "$hole_start" "$hole_size" 1500)"
parted -s "$img_nvme" mkpart root btrfs "${rs}MiB" "$((rs + rsz))MiB"
parted -s "$img_nvme" mkpart omarchy-install btrfs "${is}MiB" "$((is + isz))MiB"
num=$(find_part_number_by_name "$img_nvme" "$INSTALLER_PARTLABEL")
check "GPT name omarchy-install is findable" "[[ -n '$num' ]]"
if delete_installer_partition "$img_nvme" Recovery 2>/dev/null; then
  printf 'FAIL - delete_installer_partition must refuse Recovery\n'
  failures=$((failures + 1))
else
  printf 'ok   - delete_installer_partition refuses Recovery\n'
fi
before_types=$(sfdisk --dump "$img_nvme")
delete_installer_partition "$img_nvme"
check "installer GPT name is gone after consume" \
  "! find_part_number_by_name '$img_nvme' '$INSTALLER_PARTLABEL'"
root_num=$(find_part_number_by_name "$img_nvme" root)
grow_partition_into_next_hole "$img_nvme" "$root_num"
after_types=$(sfdisk --dump "$img_nvme")
check "iBoot type survives consume/grow" "grep -qi '$APPLE_IBOOT' <<<'$(printf '%s' "$after_types")'"
check "APFS type survives consume/grow" "grep -qi '$APPLE_APFS' <<<'$(printf '%s' "$after_types")'"
check "Recovery type survives consume/grow" "grep -qi '$APPLE_RECOVERY' <<<'$(printf '%s' "$after_types")'"
read -r _ root_end <<<"$(part_start_end_mib "$img_nvme" "$root_num")"
check "root grew past the old installer start" "(( $root_end > $is ))"
rm -f "$img_nvme"

if ! split_hole_for_tail_installer 3000 100 80 >/dev/null; then
  printf 'ok   - split refuses a hole too small for installer plus root\n'
else
  printf 'FAIL - split should refuse a tiny hole\n'
  failures=$((failures + 1))
fi

img_name=$(mktemp)
truncate -s 8G "$img_name"
parted -s "$img_name" mklabel gpt \
  mkpart iBoot 1MiB 501MiB \
  mkpart payload 501MiB 2501MiB
parted -s "$img_name" type 1 "$APPLE_IBOOT"
parted -s "$img_name" name 2 payload
if ensure_installer_partlabel "$img_name" 2>/dev/null; then
  printf 'FAIL - ensure_installer_partlabel must not rename an image path\n'
  failures=$((failures + 1))
else
  printf 'ok   - ensure_installer_partlabel ignores a non-block image\n'
fi
parted -s "$img_name" name 2 "$INSTALLER_PARTLABEL"
named=$(find_part_number_by_name "$img_name" "$INSTALLER_PARTLABEL" || true)
if [[ $named == 2 ]]; then
  printf 'ok   - parted can set GPT name omarchy-install\n'
else
  printf 'FAIL - parted can set GPT name omarchy-install\n'
  failures=$((failures + 1))
fi
if delete_installer_partition "$img_name" iBoot 2>/dev/null; then
  printf 'FAIL - must not delete iBoot by a spoofed name\n'
  failures=$((failures + 1))
else
  printf 'ok   - delete still refuses any name except omarchy-install\n'
fi
rm -f "$img_name"

if (( failures > 0 )); then
  echo "${failures} partition test failure(s)"
  exit 1
fi
echo "partition tests passed"
